* text=auto

# Unity YAML and code: diffable text with LF line endings
*.cs        text diff=csharp
*.shader    text
*.cginc     text
*.asmdef    text
*.json      text
*.inputactions text
*.unity     text eol=lf merge=unityyamlmerge
*.prefab    text eol=lf merge=unityyamlmerge
*.asset     text eol=lf merge=unityyamlmerge
*.mat       text eol=lf merge=unityyamlmerge
*.anim      text eol=lf merge=unityyamlmerge
*.controller text eol=lf merge=unityyamlmerge
*.meta      text eol=lf merge=unityyamlmerge
*.renderTexture text eol=lf merge=unityyamlmerge
*.mixer     text eol=lf merge=unityyamlmerge
*.flare     text eol=lf merge=unityyamlmerge
*.physicMaterial text eol=lf merge=unityyamlmerge

# Binary assets. After compression the whole project is ~390 MB with no file over 10 MB,
# so it is stored in plain Git: "Download ZIP" and a normal clone get every asset.
*.png  binary
*.jpg  binary
*.jpeg binary
*.tif  binary
*.psd  binary
*.exr  binary
*.fbx  binary
*.FBX  binary
*.obj  binary
*.wav  binary
*.ogg  binary
*.flac binary
*.mp3  binary
*.ttf  binary
*.otf  binary
